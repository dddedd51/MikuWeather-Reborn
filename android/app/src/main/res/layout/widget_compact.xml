<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/widget_card" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_card_light">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_city" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/widget_choose_city" android:textSize="13sp" android:textColor="#163A40" android:textStyle="bold"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextClock android:id="@+id/widget_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="M/d h:mm" android:format24Hour="M/d HH:mm" android:textSize="11sp" android:textColor="#4A747A"
                android:layout_marginStart="6dp" android:includeFontPadding="false" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.55"
                android:orientation="vertical" android:gravity="center_vertical" android:paddingEnd="4dp">
                <TextView android:id="@+id/widget_temp" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="—" android:textSize="40sp" android:textColor="#163A40" android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <ImageView android:id="@+id/widget_icon" android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_marginEnd="4dp" android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="@null" />
                    <TextView android:id="@+id/widget_weather" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/widget_waiting" android:textSize="12sp" android:textColor="#163A40"
                        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <TextView android:id="@+id/widget_feels" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#4A747A" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
                <TextView android:id="@+id/widget_range" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="#4A747A" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
            </LinearLayout>
            <ImageView android:id="@+id/widget_miku" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.45"
                android:src="@drawable/miku_overcast" android:scaleType="centerCrop" android:cropToPadding="true" android:adjustViewBounds="true" android:contentDescription="@null" />
        </LinearLayout>
        <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/widget_refresh_hint" android:textSize="11sp" android:textColor="#4A747A"
            android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_source" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/widget_attribution" android:textSize="11sp" android:textColor="#4A747A"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_refresh" android:layout_width="28dp" android:layout_height="26dp"
                android:text="↻" android:textSize="20sp" android:textColor="#087F7E" android:gravity="center" android:includeFontPadding="false"
                android:contentDescription="@string/widget_refresh" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>